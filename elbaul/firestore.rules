rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /productos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pedidos/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /ventas/{id} {
      allow read, write: if request.auth != null;
    }
  }
}