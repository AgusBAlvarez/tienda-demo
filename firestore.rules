rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@tienda-demo.com'
        ];
    }

    match /productos/{id} {
      allow read: if resource.data.estado == 'activo' || esAdmin();
      allow write: if esAdmin();
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['codigo', 'fecha', 'items', 'total', 'estado'])
        && request.resource.data.keys().hasAll(['codigo', 'fecha', 'items', 'total', 'estado'])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() >= 4
        && request.resource.data.codigo.size() <= 10
        && request.resource.data.codigo == id
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.fecha == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read, update, delete: if esAdmin();
    }

    match /ventas/{id} {
      allow read, write: if esAdmin();
    }
  }
}